{
  "id": "nu.creative.studio",
  "name": "N.U Creative Studio and Graphics Platform",
  "version": "0.1.0-preview",
  "status": "offline-source-bundle-preview",
  "generation": {
    "min": 1,
    "max": 1
  },
  "runtime": {
    "hostApi": "nu.launcher.host/v1",
    "entry": "runtime/pixel-art-studio.html",
    "execution": "foreground-process",
    "requiredFeatures": [
      "dom",
      "canvas-2d",
      "file-import-export"
    ],
    "optionalFeatures": [
      "webgl",
      "webgpu",
      "offscreen-canvas",
      "workers",
      "filesystem-access"
    ]
  },
  "payload": {
    "entryFiles": [
      "runtime/pixel-art-studio.html",
      "runtime/nu-engine.js",
      "runtime/nu-wallet.js",
      "runtime/nu-graphics-core.js",
      "runtime/nu-svg-vectorizer.js",
      "runtime/nu-graphics-analysis.js",
      "runtime/nu-studio-layout.js",
      "runtime/nu-raster-import.js",
      "runtime/nu-pixel-art-studio.js"
    ],
    "assets": [
      "runtime/assets/"
    ],
    "data": []
  },
  "hostServices": {
    "capabilityProfile": "read-only",
    "resourceBudget": "launcher-owned-device-profile-before-import",
    "storage": "package-scoped-project-library",
    "fileImport": "explicit-user-selection; MIME-independent-extension-fallback; browser-decode-validation",
    "fileExport": "explicit-user-action",
    "originalSource": "immutable-reference-preserved",
    "network": "disabled-by-default"
  },
  "resourcePolicy": {
    "profileOwner": "launcher",
    "demoBoost": {
      "allowed": true,
      "scope": "browser-demo-session-only",
      "requiresExplicitOptIn": true,
      "requiresForegroundVisibility": true,
      "autoStopsOn": [
        "opt-out",
        "page-hidden",
        "memory-pressure",
        "host-budget-revoked"
      ],
      "mayOverrideLauncherBudget": false
    },
    "offlineMode": {
      "allowed": true,
      "requiresNetwork": false,
      "usesSameLocalHostBudget": true
    },
    "processing": {
      "preferred": [
        "streaming",
        "tiles",
        "worker-pool",
        "offscreen-canvas"
      ],
      "fallback": [
        "main-thread-chunked-processing"
      ],
      "never": [
        "unbounded-full-image-duplication"
      ]
    }
  },
  "permissions": {
    "networkDomains": [],
    "localFiles": "user-initiated-import-export-only",
    "persistentStorage": "package-scoped",
    "deviceTelemetry": "coarse-capability-only",
    "backgroundExecution": "not-requested"
  },
  "integrity": {
    "contentHashes": "SHA256SUMS.txt-generated-by-builder",
    "publisherSignature": "not-signed-preview-bundle",
    "rollback": "launcher-required-not-in-this-archive"
  },
  "limitations": [
    "This is an offline source bundle, not a native installer or signed Launcher package.",
    "The browser demo boost policy is specified but not yet wired to a runtime consent control and worker scheduler.",
    "Original imported files must remain unchanged through failed or cancelled decode, processing, history and export operations.",
    "Tile/streaming raster processing remains a follow-up; full-resolution imports are preflighted against the active device/Launcher canvas budget and fail without replacing the current project.",
    "The browser demo still needs the production Launcher host adapter; this preview consumes the local graphics capability profile."
  ]
}
